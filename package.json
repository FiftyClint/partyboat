{
  "name": "partyboat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:all": "node scripts/build-all.mjs",
    "preview": "astro preview",
    "lint:copy": "node scripts/lint-copy.mjs",
    "lint:claims": "node scripts/check-claims.mjs",
    "lint:duplicates": "node scripts/check-duplicate-copy.mjs",
    "lint:canonicals": "node scripts/check-canonicals.mjs",
    "lint:links": "node scripts/check-internal-links.mjs",
    "check": "npm run lint:copy && npm run lint:claims && npm run lint:duplicates && npm run lint:canonicals && npm run lint:links",
    "test:receiver": "node --test workers/site/*.test.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "verify": "npm run build:all && npm run check && npm run test:receiver && npm run audit:a11y",
    "check:leads": "node scripts/check-lead-destination.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "check:secrets": "node scripts/check-built-secrets.mjs",
    "check:live": "node scripts/check-live-addresses.mjs",
    "deploy": "node scripts/deploy.mjs",
    "setup:zones": "node scripts/setup-zones.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "node-html-parser": "^9.0.1",
    "playwright": "^1.50.0",
    "wrangler": "^4.118.0"
  }
}
