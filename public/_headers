# Applies only to files served straight from assets, which is these two
# paths: scripts/deploy.mjs keeps them out of run_worker_first. /_astro/ names
# carry a content hash and the fonts never change, so browsers keep them a
# year instead of asking again on every page view.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
