---
import { currentSite } from '../data/sites.mjs';
import { longDate } from '../lib/dates.mjs';
import { internalPath } from '../lib/nav.mjs';

/**
 * The date every fact on the site was last checked against its source,
 * stated where a reader (or a crawler deciding how fresh this is) sees it.
 * Marked boilerplate: same sentence on every site, different date.
 */
const site = currentSite();
---

<p class="facts-checked small" data-boilerplate>
  Facts on this page were checked against their sources on{' '}
  <time datetime={site.factsChecked}>{longDate(site.factsChecked)}</time>.{' '}
  <a href={internalPath('how-we-research')}>How we research</a>.
</p>

<style>
  .facts-checked {
    color: var(--ink-muted);
    margin: var(--s3) 0 0;
  }
</style>
