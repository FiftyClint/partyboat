---
import { currentSite } from '../data/sites.mjs';
import { longDate } from '../lib/dates.mjs';

/**
 * The key facts about a market in one table: season, price ranges, group
 * sizes, where boats leave from, who may drive. A table is the format answer
 * engines lift most reliably, and the format a planner skims first, so every
 * row carries its own source and the date it was checked.
 */
const site = currentSite();
---

<div class="glance">
  <table>
    <caption>{site.marketName} party boats at a glance</caption>
    <tbody>
      {
        site.glance.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            <td>
              {row.value}
              <span class="glance__src" data-citations>
                Source: <a href={row.source.url} rel="nofollow noopener">{row.source.label}</a>,
                checked {longDate(row.source.accessed)}
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .glance {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
  }

  caption {
    text-align: left;
    font-size: var(--text-xl);
    font-weight: 700;
    padding-bottom: var(--s3);
  }

  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: var(--s3) var(--s4);
    border-bottom: 1px solid var(--rule);
  }

  tr:last-child th,
  tr:last-child td {
    border-bottom: 0;
  }

  th {
    width: 32%;
    font-weight: 700;
    color: var(--accent-dark);
  }

  .glance__src {
    display: block;
    margin-top: var(--s1);
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  @media (max-width: 40rem) {
    th,
    td {
      display: block;
      width: auto;
    }

    th {
      padding-bottom: 0;
      border-bottom: 0;
    }
  }
</style>
