---
import { longDate } from '../lib/dates.mjs';

/**
 * The sources under a section that states facts, shown openly rather than
 * folded away. A reader checking a price, and an answer engine deciding
 * whether to trust it, should both see where it came from and when.
 *
 * Marked data-citations so the duplicate-copy checker skips it: two markets
 * in one state should cite the same state law.
 */
const { sources = [], label = 'Sources' } = Astro.props;
---

{
  sources.length > 0 && (
    <div class="sources small" data-citations>
      <p class="sources__label">{label}</p>
      <ol>
        {sources.map((s) => (
          <li>
            <a href={s.url} rel="nofollow noopener">
              {s.label}
            </a>
            , checked <time datetime={s.accessed}>{longDate(s.accessed)}</time>
          </li>
        ))}
      </ol>
    </div>
  )
}

<style>
  .sources {
    margin-top: var(--s5);
    padding-top: var(--s3);
    border-top: 1px solid var(--rule);
    color: var(--ink-muted);
  }

  .sources__label {
    font-weight: 700;
    margin: 0 0 var(--s2);
  }

  .sources ol {
    margin: 0;
    padding-left: var(--s5);
  }

  .sources li {
    margin-bottom: var(--s1);
  }
</style>
