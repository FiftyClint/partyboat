---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { currentSite } from '../data/sites.mjs';

/** The only route in src/pages. Every site needs it. */
const site = currentSite();
---

<Base title="Page not found" description="That page does not exist." path="/404" noindex>
  <div class="page section">
    <div class="measure">
      <h1>We could not find that page</h1>
      <p class="lede">
        The address may have changed, or the link that brought you here may have a typo in it.
      </p>
      <p>The home page has the trip request form and everything else on {site.siteName}.</p>
      <p style="margin-top: var(--s6)">
        <Button href="/">Go to the home page</Button>
      </p>
    </div>
  </div>
</Base>
