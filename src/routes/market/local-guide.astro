---
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import Sources from '../../components/Sources.astro';
import Disclosure from '../../components/Disclosure.astro';
import Button from '../../components/Button.astro';
import FactsChecked from '../../components/FactsChecked.astro';
import { currentSite } from '../../data/sites.mjs';

/**
 * The long local guide: the rules on the water, the well-known spots, getting
 * there, where to stay. This is the page that has to be worth reading on its
 * own, because it is what makes the site more than a form with a lake's name
 * on it.
 */
const site = currentSite();
/* Stable anchors so a contents list, or an answer engine, can point at one section. */
const anchor = (title) => title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<Base title={site.guide.title} description={site.guide.description} path="/local-guide">
  <div class="page section">
    <Prose>
      <h1>{site.guide.title}</h1>
      <p class="lede">{site.guide.intro}</p>
      <FactsChecked />

      <nav class="toc" aria-label="On this page">
        <p class="toc__label">On this page</p>
        <ol>
          {site.guide.sections.map((s) => (
            <li>
              <a href={`#${anchor(s.title)}`}>{s.title}</a>
            </li>
          ))}
          <li>
            <a href="#the-rules-on-the-water">The rules on the water</a>
          </li>
        </ol>
      </nav>

      {
        site.guide.sections.map((s) => (
          <section>
            <h2 id={anchor(s.title)}>{s.title}</h2>
            {s.body.split(/\n+/).map((para) => (
              <p>{para}</p>
            ))}
          </section>
        ))
      }
      <Sources sources={site.guide.sources} />

      <section>
        <h2 id="the-rules-on-the-water">The rules on the water</h2>
        {site.rules.summary.split(/\n+/).map((para) => <p>{para}</p>)}
        <Sources sources={site.rules.sources} />
      </section>
    </Prose>

    <div class="guide-cta">
      <Disclosure />
      <Button href="/#request">Request a party boat</Button>
    </div>
  </div>
</Base>

<style>
  .toc {
    margin: var(--s5) 0;
    padding: var(--s4) var(--s5);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .toc__label {
    font-weight: 700;
    margin: 0 0 var(--s2);
  }

  .toc ol {
    margin: 0;
  }

  .guide-cta {
    max-width: 40rem;
    margin-top: var(--s7);
  }
</style>
