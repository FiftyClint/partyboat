---
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import Sources from '../../components/Sources.astro';
import Disclosure from '../../components/Disclosure.astro';
import Button from '../../components/Button.astro';
import { currentSite } from '../../data/sites.mjs';

/**
 * The long local guide: the rules on the water, the well-known spots, getting
 * there, where to stay. This is the page that has to be worth reading on its
 * own, because it is what makes the site more than a form with a lake's name
 * on it.
 */
const site = currentSite();
---

<Base title={site.guide.title} description={site.guide.description} path="/local-guide">
  <div class="page section">
    <Prose>
      <h1>{site.guide.title}</h1>
      <p class="lede">{site.guide.intro}</p>

      {
        site.guide.sections.map((s) => (
          <section>
            <h2>{s.title}</h2>
            {s.body.split('\n\n').map((para) => (
              <p>{para}</p>
            ))}
          </section>
        ))
      }
      <Sources sources={site.guide.sources} />

      <section>
        <h2>The rules on the water</h2>
        {site.rules.summary.split('\n\n').map((para) => <p>{para}</p>)}
        <Sources sources={site.rules.sources} />
      </section>
    </Prose>

    <div class="guide-cta">
      <Disclosure />
      <Button href="/#request">Request a party boat</Button>
    </div>
  </div>
</Base>

<style>
  .guide-cta {
    max-width: 40rem;
    margin-top: var(--s7);
  }
</style>
